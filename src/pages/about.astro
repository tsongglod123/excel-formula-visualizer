---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="About — Excel Formula Visualizer" description="Learn about the Excel Formula Visualizer project and its mission." currentPath="/about">
  <Hero
    title="About the "
    highlightedText="Project"
    description="A simple tool to make Excel formulas easier to understand."
    showInput={false}
  />

  <section class="border-t border-border py-12 sm:py-16" aria-labelledby="mission-heading">
    <div class="mx-auto max-w-3xl">
      <h2 id="mission-heading" class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        Our Mission
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-muted sm:text-base">
        Excel formulas can be hard to read — especially when you inherit a spreadsheet from someone else.
        The Excel Formula Visualizer breaks any formula into clear, color-coded blocks with plain-English
        explanations so you can understand it at a glance.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-ink-muted sm:text-base">
        Whether you're learning Excel, auditing a colleague's work, or just trying to remember what a
        formula does, the visualizer helps you see exactly what's happening.
      </p>
      <div class="mt-6">
        <a
          href="https://github.com/tsongglod123/excel-formula-visualizer"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface-elevated px-5 py-2.5 text-sm font-medium text-ink-muted shadow-sm transition hover:border-accent hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" clip-rule="evenodd" />
          </svg>
          View on GitHub
        </a>
      </div>
    </div>
  </section>
</Layout>