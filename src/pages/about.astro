---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="About — Excel Formula Visualizer" description="Learn about the Excel Formula Visualizer project, its mission, and technology stack." currentPath="/about">
  <!-- Page Hero -->
  <Hero
    title="About the "
    highlightedText="Project"
    description="Learn about the Excel Formula Visualizer, its mission, and the technology behind it."
    showInput={false}
  />

  <!-- Mission -->
  <section class="border-t border-gray-200 py-12 sm:py-16" aria-labelledby="mission-heading">
    <div class="mx-auto max-w-3xl">
      <h2 id="mission-heading" class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
        Our Mission
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-gray-600 sm:text-base">
        Excel formulas are powerful, but they can also be intimidating. When you inherit a spreadsheet from a colleague 
        or revisit your own work months later, understanding what a complex formula does can be a challenge.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-gray-600 sm:text-base">
        The Excel Formula Visualizer was created to bridge that gap. Our mission is to make every Excel formula 
        accessible and understandable by providing instant, interactive visual breakdowns. Whether you're a beginner 
        learning the basics or an expert debugging a complex nested formula, the visualizer helps you see exactly 
        what's happening under the hood.
      </p>
    </div>
  </section>

  <!-- Technology Stack -->
  <section class="border-t border-gray-200 py-12 sm:py-16" aria-labelledby="tech-heading">
    <div class="mx-auto max-w-3xl">
      <h2 id="tech-heading" class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
        Technology Stack
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-gray-600 sm:text-base">
        Built with modern web technologies for performance, accessibility, and maintainability.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-semibold text-gray-900">Astro</h3>
          <p class="mt-1 text-xs text-gray-500">
            A modern web framework for building fast, content-focused websites. Delivers zero-JS by default.
          </p>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-semibold text-gray-900">Tailwind CSS v4</h3>
          <p class="mt-1 text-xs text-gray-500">
            A utility-first CSS framework for rapid, responsive design with a consistent design system.
          </p>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-semibold text-gray-900">TypeScript</h3>
          <p class="mt-1 text-xs text-gray-500">
            Type-safe JavaScript for better developer experience and fewer runtime errors.
          </p>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-semibold text-gray-900">Netlify</h3>
          <p class="mt-1 text-xs text-gray-500">
            Deployed on Netlify for global CDN distribution, automatic HTTPS, and continuous deployment.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Open Source -->
  <section class="border-t border-gray-200 py-12 sm:py-16" aria-labelledby="opensource-heading">
    <div class="mx-auto max-w-3xl">
      <h2 id="opensource-heading" class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
        Open Source
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-gray-600 sm:text-base">
        This project is open source and available on GitHub. Contributions, bug reports, and feature requests 
        are welcome. Whether you want to add support for more Excel functions, improve the UI, or fix a bug, 
        we'd love your help.
      </p>
      <div class="mt-6">
        <a
          href="https://github.com/tsongglod123/excel-formula-visualizer"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 shadow-sm transition hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" clip-rule="evenodd" />
          </svg>
          View on GitHub
        </a>
      </div>
    </div>
  </section>
</Layout>