---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeatureCard from '../components/FeatureCard.astro';
---

<Layout title="Excel Formula Visualizer — Understand Your Formulas" currentPath="/">
  <Hero
    title="Visualize & Understand "
    highlightedText="Excel Formulas"
    description="Paste any Excel formula and instantly see a clear, interactive breakdown of its components, dependencies, and evaluation order."
    showInput={true}
  />

  <section class="border-t border-border py-12 sm:py-16" aria-labelledby="features-heading">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="features-heading" class="text-2xl font-bold tracking-tight text-ink sm:text-3xl text-balance">
        Everything You Need to Understand Formulas
      </h2>
      <p class="mt-3 text-sm text-ink-muted sm:text-base">
        From simple arithmetic to complex nested functions, get full clarity on how your formulas work.
      </p>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <FeatureCard
        title="Parse & Structure"
        description="Break any formula into a clear tree of functions, operators, references, and literals."
        icon="parse"
      />
      <FeatureCard
        title="Step-by-Step Evaluation"
        description="Walk through the evaluation order from innermost to outermost with play, pause, and step controls."
        icon="evaluation"
      />
      <FeatureCard
        title="Reference Map"
        description="Click any cell reference to highlight all occurrences and trace dependencies at a glance."
        icon="reference"
      />
      <FeatureCard
        title="Plain English Translation"
        description="Every part of your formula is translated into a readable sentence — no Excel expertise required."
        icon="translation"
      />
      <FeatureCard
        title="Hover Highlighting"
        description="Hover any node to highlight its parent chain and children while dimming the rest of the tree."
        icon="highlight"
      />
      <FeatureCard
        title="Collapsible Groups"
        description="Collapse large functions or parenthetical groups to focus on the parts that matter right now."
        icon="collapse"
      />
    </div>
  </section>

  <section class="border-t border-border py-12 sm:py-16" aria-labelledby="example-heading">
    <div class="mx-auto max-w-3xl">
      <h2 id="example-heading" class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        See It in Action
      </h2>
      <p class="mt-3 text-sm text-ink-muted sm:text-base">
        Enter a formula like <code class="rounded bg-border/50 px-1.5 py-0.5 text-sm font-mono text-ink-muted">=IF(SUM(A1:A10)>100, "Over Budget", "Within Budget")</code>
        and get an instant visual breakdown.
      </p>

      <div class="mt-6 overflow-hidden rounded-xl border border-border bg-surface-elevated sm:mt-8">
        <div class="overflow-x-auto p-4 sm:p-6">
          <pre class="text-sm"><code class="text-ink">=IF(
  <span class="text-sky-700">SUM</span>(<span class="text-violet-700">A1:A10</span>) <span class="text-amber-700">> 100</span>,
  <span class="text-emerald-700">"Over Budget"</span>,
  <span class="text-emerald-700">"Within Budget"</span>
)</code></pre>
        </div>

        <div class="border-t border-border bg-surface px-4 py-3 sm:px-6">
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center rounded-full bg-sky-100 px-2.5 py-0.5 text-xs font-medium text-sky-800">IF</span>
            <span class="inline-flex items-center rounded-full bg-sky-100 px-2.5 py-0.5 text-xs font-medium text-sky-800">SUM</span>
            <span class="inline-flex items-center rounded-full bg-violet-100 px-2.5 py-0.5 text-xs font-medium text-violet-800">A1:A10</span>
            <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">> 100</span>
            <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-800">"Over Budget"</span>
            <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-800">"Within Budget"</span>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center sm:mt-10">
        <a
          href="/how-it-works"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-accent-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
        >
          Learn How It Works
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-border py-12 sm:py-16" aria-labelledby="stats-heading">
    <div class="mx-auto max-w-4xl text-center">
      <h2 id="stats-heading" class="sr-only">Statistics</h2>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        <div class="flex flex-col items-center">
          <span class="text-3xl font-bold text-accent sm:text-4xl">50+</span>
          <span class="mt-1 text-sm text-ink-muted">Formulas Supported</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-bold text-accent sm:text-4xl">100%</span>
          <span class="mt-1 text-sm text-ink-muted">Free to Use</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-bold text-accent sm:text-4xl">Instant</span>
          <span class="mt-1 text-sm text-ink-muted">Real-Time Parsing</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-bold text-accent sm:text-4xl">Open</span>
          <span class="mt-1 text-sm text-ink-muted">Source Code</span>
        </div>
      </div>
    </div>
  </section>
</Layout>