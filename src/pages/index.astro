---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeatureCard from '../components/FeatureCard.astro';
---

<Layout title="Excel Formula Visualizer — Understand Your Formulas" currentPath="/">
  <!-- Hero Section -->
  <Hero
    title="Visualize & Understand "
    highlightedText="Excel Formulas"
    description="Paste any Excel formula and instantly see a clear, interactive breakdown of its components, dependencies, and evaluation order."
    showInput={true}
  />

  <!-- Features Grid -->
  <section class="border-t border-gray-200 py-12 sm:py-16" aria-labelledby="features-heading">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="features-heading" class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
        Everything You Need to Understand Formulas
      </h2>
      <p class="mt-3 text-sm text-gray-500 sm:text-base">
        From simple arithmetic to complex nested functions, get full clarity on how your formulas work.
      </p>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <FeatureCard
        title="Parse & Structure"
        description="Automatically parse any Excel formula into a structured tree of functions, operators, references, and literals."
        icon="parse"
        color="blue"
      />
      <FeatureCard
        title="Evaluation Order"
        description="See the step-by-step evaluation order with color-coded groupings that make complex logic easy to follow."
        icon="evaluation"
        color="green"
      />
      <FeatureCard
        title="Interactive Reference Map"
        description="Click on any cell reference to highlight its location and trace dependencies across your spreadsheet."
        icon="reference"
        color="purple"
      />
      <FeatureCard
        title="Color-Coded Syntax"
        description="Functions, operators, cell references, and literals are highlighted with distinct colors for instant recognition."
        icon="color"
        color="pink"
      />
      <FeatureCard
        title="Export & Share"
        description="Export your formula breakdown as an image or share a link with colleagues for collaborative debugging."
        icon="export"
        color="teal"
      />
      <FeatureCard
        title="Real-Time Collaboration"
        description="Share your visualization with teammates and collaborate on understanding complex formulas together."
        icon="share"
        color="amber"
      />
    </div>
  </section>

  <!-- Quick Start / Example -->
  <section class="border-t border-gray-200 py-12 sm:py-16" aria-labelledby="example-heading">
    <div class="mx-auto max-w-3xl">
      <h2 id="example-heading" class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
        See It in Action
      </h2>
      <p class="mt-3 text-sm text-gray-500 sm:text-base">
        Enter a formula like <code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm font-mono">=IF(SUM(A1:A10)>100, "Over Budget", "Within Budget")</code>
        and get an instant visual breakdown.
      </p>

      <!-- Formula Visualization Example -->
      <div class="mt-6 overflow-hidden rounded-xl border border-gray-200 bg-gray-50 sm:mt-8">
        <!-- Formula Code -->
        <div class="border-b border-gray-200 bg-white px-4 py-3 sm:px-6">
          <div class="flex items-center gap-2">
            <span class="flex h-3 w-3 rounded-full bg-red-400" aria-hidden="true"></span>
            <span class="flex h-3 w-3 rounded-full bg-yellow-400" aria-hidden="true"></span>
            <span class="flex h-3 w-3 rounded-full bg-green-400" aria-hidden="true"></span>
            <span class="ml-2 text-xs font-medium text-gray-400">formula</span>
          </div>
        </div>
        <div class="overflow-x-auto p-4 sm:p-6">
          <pre class="text-sm"><code class="text-gray-800">=IF(
  <span class="text-blue-700">SUM</span>(<span class="text-purple-700">A1:A10</span>) <span class="text-amber-700">> 100</span>,
  <span class="text-green-700">"Over Budget"</span>,
  <span class="text-green-700">"Within Budget"</span>
)</code></pre>
        </div>

        <!-- Color Legend -->
        <div class="border-t border-gray-200 bg-white px-4 py-3 sm:px-6">
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800">IF</span>
            <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800">SUM</span>
            <span class="inline-flex items-center rounded-full bg-purple-100 px-2.5 py-0.5 text-xs font-medium text-purple-800">A1:A10</span>
            <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">> 100</span>
            <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">"Over Budget"</span>
            <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">"Within Budget"</span>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-8 text-center sm:mt-10">
        <a
          href="/how-it-works"
          class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        >
          Learn How It Works
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Stats / Trust Section -->
  <section class="border-t border-gray-200 py-12 sm:py-16" aria-labelledby="stats-heading">
    <div class="mx-auto max-w-4xl text-center">
      <h2 id="stats-heading" class="sr-only">Statistics</h2>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        <div class="flex flex-col items-center">
          <span class="text-3xl font-bold text-blue-600 sm:text-4xl">50+</span>
          <span class="mt-1 text-sm text-gray-500">Formulas Supported</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-bold text-blue-600 sm:text-4xl">100%</span>
          <span class="mt-1 text-sm text-gray-500">Free to Use</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-bold text-blue-600 sm:text-4xl">Instant</span>
          <span class="mt-1 text-sm text-gray-500">Real-Time Parsing</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-bold text-blue-600 sm:text-4xl">Open</span>
          <span class="mt-1 text-sm text-gray-500">Source Code</span>
        </div>
      </div>
    </div>
  </section>
</Layout>