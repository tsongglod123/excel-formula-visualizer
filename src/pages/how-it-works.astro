---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeatureCard from '../components/FeatureCard.astro';
---

<Layout title="How It Works — Excel Formula Visualizer" description="Learn how the Excel Formula Visualizer parses and breaks down formulas step by step." currentPath="/how-it-works">
  <!-- Page Hero -->
  <Hero
    title="How It "
    highlightedText="Works"
    description="Understanding how the Excel Formula Visualizer parses and breaks down your formulas into clear, actionable insights."
    showInput={false}
  />

  <!-- Step-by-step Process -->
  <section class="border-t border-gray-200 py-12 sm:py-16" aria-labelledby="process-heading">
    <div class="mx-auto max-w-3xl">
      <h2 id="process-heading" class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl text-center">
        The Process
      </h2>
      <p class="mt-3 text-center text-sm text-gray-500 sm:text-base">
        Three simple steps from formula to full understanding.
      </p>

      <div class="mt-10 space-y-8 sm:space-y-12">
        <!-- Step 1 -->
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-600 text-sm font-bold text-white">
            1
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-semibold text-gray-900">Paste Your Formula</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              Enter any Excel formula into the input field. Whether it's a simple <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs font-mono">=SUM(A1:A10)</code> 
              or a complex nested expression, the parser handles it all. The tool supports over 50 Excel functions 
              including logical, lookup, math, text, and date functions.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-600 text-sm font-bold text-white">
            2
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-semibold text-gray-900">Instant Parsing & Analysis</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              The formula is parsed into an Abstract Syntax Tree (AST) where each component is identified and categorized:
            </p>
            <ul class="mt-3 space-y-2 text-sm text-gray-600">
              <li class="flex items-start gap-2">
                <span class="mt-1 flex h-2 w-2 shrink-0 rounded-full bg-blue-400" aria-hidden="true"></span>
                <span><strong class="text-gray-900">Functions</strong> — <code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">IF</code>, <code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">SUM</code>, <code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">VLOOKUP</code>, and more</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1 flex h-2 w-2 shrink-0 rounded-full bg-purple-400" aria-hidden="true"></span>
                <span><strong class="text-gray-900">Cell References</strong> — Relative (<code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">A1</code>), absolute (<code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">$A$1</code>), and ranges (<code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">A1:A10</code>)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1 flex h-2 w-2 shrink-0 rounded-full bg-amber-400" aria-hidden="true"></span>
                <span><strong class="text-gray-900">Operators</strong> — Arithmetic (<code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">+</code>, <code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">-</code>, <code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">*</code>, <code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">/</code>), comparison (<code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">{'>'}</code>, <code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">{'<'}</code>), and text concatenation (<code class="rounded bg-gray-100 px-1 py-0.5 text-xs font-mono">{'&'}</code>)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1 flex h-2 w-2 shrink-0 rounded-full bg-green-400" aria-hidden="true"></span>
                <span><strong class="text-gray-900">Literals</strong> — Text strings, numbers, and boolean values</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-600 text-sm font-bold text-white">
            3
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-semibold text-gray-900">Visual Breakdown</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              The parsed components are rendered in a color-coded, interactive visualization. Each part of the formula 
              is clearly labeled and grouped by evaluation order, making it easy to understand how Excel processes 
              your formula from the innermost functions outward.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Supported Functions -->
  <section class="border-t border-gray-200 py-12 sm:py-16" aria-labelledby="functions-heading">
    <div class="mx-auto max-w-3xl">
      <h2 id="functions-heading" class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl text-center">
        Supported Functions
      </h2>
      <p class="mt-3 text-center text-sm text-gray-500 sm:text-base">
        The visualizer supports a wide range of Excel functions across multiple categories.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-semibold text-gray-900">Math & Trig</h3>
          <ul class="mt-2 space-y-1">
            {['SUM', 'AVERAGE', 'COUNT', 'MAX', 'MIN', 'ROUND', 'ABS', 'SUMPRODUCT'].map((fn) => (
              <li class="text-xs text-gray-500 font-mono">{fn}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-semibold text-gray-900">Logical</h3>
          <ul class="mt-2 space-y-1">
            {['IF', 'AND', 'OR', 'NOT', 'IFERROR', 'IFNA', 'TRUE', 'FALSE'].map((fn) => (
              <li class="text-xs text-gray-500 font-mono">{fn}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-semibold text-gray-900">Lookup & Reference</h3>
          <ul class="mt-2 space-y-1">
            {['VLOOKUP', 'HLOOKUP', 'XLOOKUP', 'INDEX', 'MATCH', 'CHOOSE', 'OFFSET', 'INDIRECT'].map((fn) => (
              <li class="text-xs text-gray-500 font-mono">{fn}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-5">
          <h3 class="text-sm font-semibold text-gray-900">Text</h3>
          <ul class="mt-2 space-y-1">
            {['CONCATENATE', 'LEFT', 'RIGHT', 'MID', 'LEN', 'FIND', 'REPLACE', 'TEXT'].map((fn) => (
              <li class="text-xs text-gray-500 font-mono">{fn}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-gray-200 py-12 sm:py-16">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
        Ready to Try It?
      </h2>
      <p class="mt-3 text-sm text-gray-500 sm:text-base">
        Paste your first formula and see the visual breakdown instantly.
      </p>
      <div class="mt-6">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" />
          </svg>
          Get Started Now
        </a>
      </div>
    </div>
  </section>
</Layout>