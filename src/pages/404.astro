---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found | Excel Formula Visualizer" description="The page you're looking for doesn't exist." currentPath="">
  <section class="flex flex-col items-center justify-center py-16 text-center sm:py-24 lg:py-32">
    <div class="flex items-center justify-center" aria-hidden="true">
      <span class="text-8xl font-bold tracking-tighter text-border sm:text-9xl">4</span>
      <span class="mx-2 inline-flex h-20 w-20 items-center justify-center rounded-2xl bg-accent-subtle text-4xl font-bold text-accent sm:h-28 sm:w-28 sm:text-6xl">0</span>
      <span class="text-8xl font-bold tracking-tighter text-border sm:text-9xl">4</span>
    </div>

    <h1 class="mt-6 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
      Page Not Found
    </h1>
    <p class="mt-3 max-w-md text-sm text-ink-muted sm:text-base">
      Sorry, the page you're looking for doesn't exist or has been moved.
      Let's get you back to visualizing formulas.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-accent-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        Go Home
      </a>
      <a
        href="/how-it-works"
        class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface-elevated px-6 py-3 text-sm font-medium text-ink-muted shadow-sm transition hover:border-accent hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        Learn How It Works
      </a>
    </div>
  </section>
</Layout>