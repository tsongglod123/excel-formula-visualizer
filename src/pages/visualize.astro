---
import Layout from '../layouts/Layout.astro';
import FormulaEditor from '../components/astro/FormulaEditor.astro';
import CopyUrlButton from '../components/astro/CopyUrlButton.astro';
import VisualizerClient from '../components/react/VisualizerClient';
import { parse, FormulaError, type ASTNode } from '../lib/parser';
import { translate, translateNode, type NodeTranslation } from '../lib/translate';

export const prerender = false;

const formula = Astro.url.searchParams.get('formula');

let ast: ASTNode | null = null;
let translation = '';
let nodeTranslations: NodeTranslation | null = null;
let error: string | null = null;

if (!formula) {
  error = 'No formula provided. Enter one below to start visualizing.';
} else if (!formula.trim().startsWith('=')) {
  error = 'Formula must start with "=". Check your input and try again.';
} else {
  try {
    ast = parse(formula);
    translation = translate(ast);
    nodeTranslations = translateNode(ast);
  } catch (e) {
    if (e instanceof FormulaError) {
      error = `Parse error at position ${e.position}: ${e.message}`;
    } else {
      error = 'An unexpected error occurred while parsing the formula.';
    }
  }
}
---

<Layout title={formula ? `Visualize: ${formula}` : 'Visualize Formula'} currentPath="/visualize">
  {error ? (
    <div class="mx-auto max-w-3xl space-y-6">
      <div class="rounded-xl border border-red-200 bg-red-50 p-6 sm:p-8">
        <div class="flex items-start gap-4">
          <svg class="h-6 w-6 shrink-0 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
          </svg>
          <div>
            <h1 class="text-lg font-bold text-red-900 sm:text-xl">Unable to Visualize Formula</h1>
            <p class="mt-1 text-sm text-red-700">{error}</p>
          </div>
        </div>
        {formula && (
          <p class="mt-4 break-all rounded-lg bg-red-100 px-3 py-2 font-mono text-sm text-red-900">
            {formula}
          </p>
        )}
      </div>

      <div class="rounded-xl border border-border bg-surface-elevated p-5">
        <label for="visualize-formula-input" class="block text-sm font-semibold text-ink">Paste a New Formula</label>
        <p class="mt-1 text-xs text-ink-muted">Enter an Excel formula starting with = to visualize it instantly.</p>
        <div class="mt-4">
          <FormulaEditor formula={formula ?? ''} id="visualize-formula-input" />
        </div>
      </div>
    </div>
  ) : (
    <div class="space-y-6">
      {/* Slim editor bar — the formula itself already shows in the input and
          in the evaluator's fx formula bar, so no separate read-only display. */}
      <section class="rounded-xl border border-border bg-surface-elevated p-4" aria-label="Edit or share the formula">
        <h1 class="sr-only">Visualize formula</h1>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <div class="min-w-0 flex-1">
            <FormulaEditor formula={formula ?? ''} id="visualize-formula-input" buttonText="Update" icon="refresh" />
          </div>
          <CopyUrlButton />
        </div>
      </section>

      {ast && nodeTranslations && (
        <VisualizerClient
          client:load
          ast={ast}
          translation={translation}
          nodeTranslations={nodeTranslations}
        />
      )}
    </div>
  )}
</Layout>