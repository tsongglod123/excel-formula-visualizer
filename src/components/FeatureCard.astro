---
export interface Props {
  title: string;
  description: string;
  icon: 'parse' | 'evaluation' | 'reference' | 'translation' | 'highlight' | 'collapse';
}

const { title, description, icon } = Astro.props;
---

<article class="group rounded-xl border border-border bg-surface-elevated p-5 transition hover:border-accent/40 hover:shadow-sm dark:bg-stone-950">
  <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-border/50 text-ink-muted ring-1 ring-border transition group-hover:bg-accent-subtle group-hover:text-accent group-hover:ring-accent/30 dark:bg-stone-900 dark:ring-stone-800 dark:group-hover:bg-amber-950/30">
    {icon === 'parse' && (
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" />
      </svg>
    )}
    {icon === 'evaluation' && (
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    )}
    {icon === 'reference' && (
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
      </svg>
    )}
    {icon === 'translation' && (
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h3m-3 3h3m-3-6h6m-6 0V3m3 9v3m-3 0h6m-6 0v3M3 7.5h3.75M3 12h3.75M3 16.5h3.75M21 7.5h-3.75M21 12h-3.75M21 16.5h-3.75" />
      </svg>
    )}
    {icon === 'highlight' && (
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 11.715 18 12l-.259-.285a3.75 3.75 0 0 0-2.586-1.11L14.25 10.5l.285-.259a3.75 3.75 0 0 0 1.11-2.586L15.75 7.5l.285.285a3.75 3.75 0 0 0 2.586 1.11L18.75 9l-.285.259a3.75 3.75 0 0 0-1.11 2.586Z" />
      </svg>
    )}
    {icon === 'collapse' && (
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    )}
  </div>
  <h3 class="mt-3.5 text-sm font-semibold text-ink">{title}</h3>
  <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{description}</p>
</article>
