---
export interface Props {
  title: string;
  highlightedText: string;
  description: string;
  showInput?: boolean;
}

const { title, highlightedText, description, showInput = true } = Astro.props;
---

<section class="relative flex flex-col items-center py-12 text-center sm:py-16 lg:py-24">
  <!-- Background gradient decoration -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-40 left-1/2 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-gradient-to-br from-blue-100/40 to-purple-100/40 blur-3xl sm:h-[600px] sm:w-[600px] lg:h-[800px] lg:w-[800px]"></div>
    <div class="absolute -bottom-40 right-0 h-[300px] w-[300px] rounded-full bg-gradient-to-tl from-blue-50/30 to-purple-50/30 blur-2xl sm:h-[400px] sm:w-[400px]"></div>
  </div>

  <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl md:text-5xl lg:text-6xl">
    {title}
    <span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
      {highlightedText}
    </span>
  </h1>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-gray-600 sm:mt-6 sm:text-lg md:text-xl">
    {description}
  </p>

  {
    showInput && (
      <div class="mt-8 w-full max-w-2xl sm:mt-10">
        <form class="flex flex-col gap-3 sm:flex-row sm:gap-4" action="/visualize" method="GET">
          <label for="formula-input" class="sr-only">Enter an Excel formula</label>
          <input
            id="formula-input"
            name="formula"
            type="text"
            placeholder="e.g. =SUM(A1:A10)*VLOOKUP(B5, $D$1:$E$20, 2, FALSE)"
            class="flex-1 rounded-lg border border-gray-300 px-4 py-3 text-sm text-gray-900 placeholder-gray-400 shadow-sm transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
          />
          <button
            type="submit"
            class="rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:shrink-0"
          >
            <span class="flex items-center gap-2">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
              </svg>
              Visualize
            </span>
          </button>
        </form>
        <p class="mt-3 text-xs text-gray-400">
          Try: <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs">=SUM(A1:A10)</code>,
          <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs">=IF(B2>100, "High", "Low")</code>
        </p>
      </div>
    )
  }
</section>