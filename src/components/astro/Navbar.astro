---
export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/how-it-works', label: 'How It Works' },
  { href: '/about', label: 'About' },
];
---

<nav class="relative flex items-center justify-between" aria-label="Global">
  <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-ink transition hover:text-accent-hover">
    <svg
      class="h-6 w-6 text-accent"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605"
      />
    </svg>
    <span class="hidden sm:inline">Excel Formula Visualizer</span>
    <span class="sm:hidden">EFV</span>
  </a>

  <div class="hidden items-center gap-1 sm:flex">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-lg px-4 py-2 text-sm font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-accent',
            currentPath === link.href
              ? 'bg-accent-subtle text-accent'
              : 'text-ink-muted hover:bg-border hover:text-ink',
          ]}
          aria-current={currentPath === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <div class="flex items-center gap-2 sm:hidden">
    <button
      id="mobile-menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-ink-muted transition hover:bg-border hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6 menu-open-icon" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg class="hidden h-6 w-6 menu-close-icon" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</nav>

<div
  id="mobile-menu"
  class="hidden mt-4 rounded-xl border border-border bg-surface-elevated p-4 shadow-sm sm:hidden"
  role="menu"
>
  <div class="flex flex-col gap-1">
    {
      links.map((link) => (
        <a
          href={link.href}
          role="menuitem"
          class:list={[
            'rounded-lg px-4 py-3 text-sm font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-accent',
            currentPath === link.href
              ? 'bg-accent-subtle text-accent'
              : 'text-ink-muted hover:bg-border hover:text-ink',
          ]}
          aria-current={currentPath === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</div>

<script>
  function setMenuState(toggle: HTMLElement, menu: HTMLElement, open: boolean): void {
    const openIcon = toggle.querySelector('.menu-open-icon');
    const closeIcon = toggle.querySelector('.menu-close-icon');
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  }

  // astro:page-load fires on the initial page load and after every client-side
  // navigation from <ClientRouter />. Inline scripts are deduplicated across
  // page swaps and never re-run, which left the swapped-in toggle button with
  // no click listener after navigation. Re-wire it on every page load instead.
  document.addEventListener('astro:page-load', () => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      setMenuState(toggle, menu, menu.classList.contains('hidden'));
    });
  });

  // Registered once at module scope. Elements are looked up when the event
  // fires, so this always operates on the current DOM — even after page swaps.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (toggle && menu && !menu.classList.contains('hidden')) {
      setMenuState(toggle, menu, false);
    }
  });
</script>