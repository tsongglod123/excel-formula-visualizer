---
import FormulaEditor from './FormulaEditor.astro';
import RecentFormulas from '../react/RecentFormulas';

export interface Props {
  title: string;
  highlightedText: string;
  description: string;
  showInput?: boolean;
}

const { title, highlightedText, description, showInput = true } = Astro.props;
---

<section class="flex flex-col items-center py-12 text-center sm:py-16 lg:py-20">
  <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-ink sm:text-4xl md:text-5xl text-balance">
    {title}
    <span class="text-accent">{highlightedText}</span>
  </h1>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-muted sm:mt-6 sm:text-lg">
    {description}
  </p>

  {
    showInput && (
      <div class="mt-8 w-full max-w-2xl sm:mt-10">
        <FormulaEditor />
        <p class="mt-3 text-xs text-ink-muted/80">
          Try:{' '}
          <code class="rounded bg-border/50 px-1.5 py-0.5 text-xs font-mono text-ink-muted">=SUM(A1:A10)</code>,{' '}
          <code class="rounded bg-border/50 px-1.5 py-0.5 text-xs font-mono text-ink-muted">=IF(B2>100, "High", "Low")</code>
        </p>
        <RecentFormulas client:load />
      </div>
    )
  }
</section>
