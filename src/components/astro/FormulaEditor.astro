---
export interface Props {
  formula?: string;
  action?: string;
  label?: string;
  placeholder?: string;
  buttonText?: string;
  id?: string;
  icon?: 'search' | 'refresh';
}

const {
  formula = '',
  action = '/visualize',
  label = 'Excel formula',
  placeholder = 'e.g. =SUM(A1:A10)…',
  buttonText = 'Visualize',
  id = 'formula-input',
  icon = 'search',
} = Astro.props;
---

<form class="flex flex-col gap-3 sm:flex-row sm:gap-3" action={action} method="GET" novalidate>
  <label for={id} class="sr-only">{label}</label>
  <input
    {id}
    name="formula"
    type="text"
    value={formula}
    placeholder={placeholder}
    autocomplete="off"
    spellcheck="false"
    inputmode="text"
    required
    class="min-w-0 flex-1 rounded-lg border border-border bg-surface-elevated px-4 py-3 text-sm text-ink placeholder:text-ink-muted/60 shadow-sm transition focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/30"
  />
  <button
    type="submit"
    class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-accent-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
  >
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      {icon === 'refresh' ? (
        // Arrow-path: "Update" re-submits the current formula.
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
      ) : (
        // Magnifying glass: default "Visualize" search-submit on the landing page.
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      )}
    </svg>
    {buttonText}
  </button>
</form>

<script>
  // Client-side validation so users get immediate feedback before the GET request.
  // astro:page-load fires on the initial page load and after every client-side
  // navigation from <ClientRouter />, so validation is re-attached whenever
  // fresh markup is swapped in (inline scripts are deduplicated and never re-run).
  document.addEventListener('astro:page-load', () => {
    const forms = document.querySelectorAll('form[action="/visualize"]');
    forms.forEach((form) => {
      form.addEventListener('submit', (event) => {
        const input = form.querySelector('input[name="formula"]');
        if (!(input instanceof HTMLInputElement)) return;
        const value = input.value.trim();
        if (!value) {
          event.preventDefault();
          input.setCustomValidity('Enter a formula to visualize.');
          input.reportValidity();
          return;
        }
        if (!value.startsWith('=')) {
          event.preventDefault();
          input.setCustomValidity('Formula must start with "=".');
          input.reportValidity();
          return;
        }
        input.setCustomValidity('');
      });

      form.addEventListener('input', (event) => {
        const input = event.target;
        if (input instanceof HTMLInputElement) input.setCustomValidity('');
      });
    });
  });
</script>
