---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border" role="contentinfo">
  <div class="flex flex-col items-center justify-between gap-4 py-8 sm:flex-row">
    <a href="/" class="flex items-center gap-2 text-sm font-semibold text-ink transition hover:text-accent-hover">
      <svg
        class="h-5 w-5 text-accent"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605"
        />
      </svg>
      Excel Formula Visualizer
    </a>
    <div class="flex items-center gap-4 text-sm text-ink-muted">
      <a href="/how-it-works" class="transition hover:text-ink">How It Works</a>
      <a href="/about" class="transition hover:text-ink">About</a>
      <a
        href="https://github.com/tsongglod123/excel-formula-visualizer"
        target="_blank"
        rel="noopener noreferrer"
        class="transition hover:text-ink"
      >
        GitHub
      </a>
    </div>
    <p class="text-xs text-ink-muted/70">&copy; {currentYear} Excel Formula Visualizer</p>
  </div>
</footer>
