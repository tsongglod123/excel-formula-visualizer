---

const currentYear = new Date().getFullYear();

interface FooterLink {
  href: string;
  label: string;
  external?: boolean;
}

interface FooterGroup {
  title: string;
  links: FooterLink[];
}

const footerLinks: FooterGroup[] = [
  {
    title: 'Product',
    links: [
      { href: '/', label: 'Home', external: false },
      { href: '/how-it-works', label: 'How It Works', external: false },
      { href: '/about', label: 'About', external: false },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: 'https://support.microsoft.com/en-us/excel', label: 'Excel Help', external: true },
      { href: 'https://github.com/tsongglod123/excel-formula-visualizer', label: 'GitHub', external: true },
    ],
  },
];
---

<footer class="border-t border-gray-200" role="contentinfo">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Footer Grid -->
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Brand Column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-gray-900">
          <svg
            class="h-6 w-6 text-blue-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605"
            />
          </svg>
          <span>Excel Formula Visualizer</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-gray-500 max-w-sm">
          A modern tool for visualizing and understanding Excel formulas. Paste any formula and get an instant, interactive breakdown.
        </p>
      </div>

      <!-- Link Columns -->
      {
        footerLinks.map((group) => (
          <div>
            <h3 class="text-sm font-semibold text-gray-900">{group.title}</h3>
            <ul class="mt-3 space-y-2">
              {
                group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                      class="text-sm text-gray-500 transition hover:text-gray-900"
                    >
                      {link.label}
                      {link.external && (
                        <svg class="inline-block h-3 w-3 ml-0.5 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V13.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                        </svg>
                      )}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom Bar -->
    <div class="mt-10 border-t border-gray-200 pt-6 text-center text-sm text-gray-500">
      <p>&copy; {currentYear} Excel Formula Visualizer. All rights reserved.</p>
    </div>
  </div>
</footer>